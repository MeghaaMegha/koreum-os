# Koreum OS environment
# Copy to .env and edit secrets before running

# App
APP_NAME=Koreum OS
APP_VERSION=0.1.0
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
FRONTEND_ORIGIN=http://localhost:5173

# Database
DATABASE_URL=postgresql+asyncpg://koreum:koreum@localhost:5432/koreum
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Redis
REDIS_URL=redis://localhost:6379/0

# Auth — CHANGE THE JWT_SECRET in production
JWT_SECRET=change-me-in-production-please-use-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Seeded admin (created by the init migration)
SEED_ADMIN_EMAIL=admin@koreum.local
SEED_ADMIN_PASSWORD=Admin123!
SEED_TENANT_NAME=Koreum Default
SEED_TENANT_SLUG=koreum

# LLM / Embedding abstraction (wired in Phase 2; Gemini is the default provider)
LLM_PROVIDER=gemini
EMBEDDING_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
